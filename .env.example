# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# Claude API key for the AI chat (from https://console.anthropic.com). Without it the chat
# uses FinProof's offline engine, which still works.
ANTHROPIC_API_KEY=

# Optional
# FINPROOF_AI=off                      # force the offline engine
# FINPROOF_AI_MODEL=claude-opus-5-5    # model for the AI chat
# FINPROOF_AI_TIMEOUT=3                # seconds before falling back to the offline engine
# FINPROOF_OFFLINE=1                   # cache only (default is hybrid: online first, cache as fallback)
