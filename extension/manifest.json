{
  "manifest_version": 3,
  "name": "FinProof",
  "version": "0.1.0",
  "description": "Shows the track record and warning signs of stock tips on YouTube. Not investment advice.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "FinProof", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
